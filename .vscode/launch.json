    "version": "0.2.0",
    "configurations": [
		{
			"name": "Debug uniswap",
			"request": "launch",
			"runtimeArgs": [
				"main.ts",
			],
			"runtimeExecutable": "ts-node",
			"skipFiles": [
				"<node_internals>/**"
			],
			"type": "node",
			"outputCapture": "std",
			"env": {
				"SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com"
			}
		},
    ]
}